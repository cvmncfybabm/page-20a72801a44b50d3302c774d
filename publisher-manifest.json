weight:700}\n.plan-card .price{font-size:36px;font-weight:800;color:var(--brown-900)}\n.plan-card .annual{display:block;font-size:14px;color:var(--brown-500);font-weight:500;margin-top:4px}\n.plan-card ul{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:12px 28px}\n.plan-card li{position:relative;padding-left:24px;font-size:15px;color:var(--brown-700)}\n.plan-card li::before{content:\"\";position:absolute;left:0;top:10px;width:10px;height:10px;background:var(--mint-500)}\n.plan-card .cta{display:inline-block;margin-top:24px;background:var(--brown-900);color:var(--cream);padding:12px 22px;font-size:14px;font-weight:600}\n.plan-card.featured .cta{background:var(--mint-500);color:var(--brown-900)}\n\n/* usage */\n#usage{background:var(--cream)}\n.usage-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:28px}\n.usage-step{background:var(--paper);padding:32px 28px 28px;position:relative;border-bottom:3px solid var(--brown-500)}\n.usage-step .step-no{font-size:14px;color:var(--mint-500);font-weight:700;letter-spacing:2px;margin-bottom:8px}\n.usage-step h3{margin:0 0 10px;font-size:20px;color:var(--brown-900)}\n.usage-step p{margin:0;font-size:15px;color:var(--brown-700)}\n\n/* client */\n#client{background:var(--brown-700);color:var(--cream)}\n#client h2{color:var(--cream)}\n#client .section-intro{color:var(--mint-100)}\n.client-grid{display:grid;grid-template-columns:1fr 1fr;gap:48px}\n.client-block{background:var(--brown-900);padding:36px;border-top:4px solid var(--mint-500)}\n.client-block h3{margin:0 0 16px;font-size:22px;color:var(--mint-300)}\n.client-block p{margin:0 0 14px;color:var(--mint-100);font-size:15px}\n.client-block .platforms{display:flex;flex-wrap:wrap;gap:10px;margin-top:18px}\n.client-block .platforms span{border:1px solid var(--brown-500);padding:6px 12px;font-size:13px;color:var(--mint-100)}\n.client-block .note{margin-top:20px;padding-top:18px;border-top:1px dashed var(--brown-500);font-size:13px;color:var(--brown-300)}\n\n/* faq */\n#faq{background:var(--cream)}\n.faq-list{display:grid;grid-template-columns:1fr;gap:16px;max-width:880px}\ndetails.qa{background:var(--paper);padding:22px 28px;border-left:4px solid var(--mint-500)}\ndetails.qa summary{cursor:pointer;font-weight:700;color:var(--brown-900);font-size:17px;list-style:none;position:relative;padding-right:32px}\ndetails.qa summary::-webkit-details-marker{display:none}\ndetails.qa summary::after{content:\"+\";position:absolute;right:0;color:var(--mint-500);font-size:22px;font-weight:700}\ndetails.qa[open] summary::after{content:\"–\"}\ndetails.qa .answer{margin-top:14px;color:var(--brown-700);font-size:15px;line-height:1.8}\ndetails.qa .answer p{margin:0 0 10px}\n\n/* footer */\nfooter{background:var(--brown-900);color:var(--brown-300);padding:48px 0 36px;font-size:14px}\nfooter .wrap{display:flex;justify-content:space-between;flex-wrap:wrap;gap:24px}\nfooter .brand{color:var(--mint-300);font-weight:700;font-size:16px}\nfooter a{color:var(--mint-100)}\nfooter a:hover{color:var(--mint-500)}\n\n@media (max-width:860px){\n  .hero-grid{grid-template-columns:1fr;gap:40px}\n  .client-grid{grid-template-columns:1fr;gap:28px}\n  .plan-card{padding:28px}\n  .numbered{padding:32px 28px}\n  .numbered .big-num{font-size:120px}\n}\n</style><nav class=\"crumb\" aria-label=\"主导航\">\n  <div class=\"wrap\">\n    <div>当前位置：<span class=\"sep\">/</span> <span class=\"here\">芒果云首页</span></div>\n    <ul>\n      <li><a href=\"#why\">为什么选芒果云</a></li>\n      <li><a href=\"#plans\">套餐选择</a></li>\n      <li><a href=\"#usage\">使用方式</a></li>\n      <li><a href=\"#client\">客户端</a></li>\n      <li><a href=\"#faq\">常见问题</a></li>\n    </ul>\n  </div>\n</nav>\n\n<header class=\"hero\">\n  <div class=\"wrap\">\n    <div class=\"hero-grid\">\n      <div>\n        <h1>芒果云，<br>把网络选择权<span class=\"mint\">还给提问者</span>。</h1>\n        <p class=\"lead\">\n          芒果云不推销“最快”“最强”，而是先问你三个问题：\n          <strong>你主要看什么？同时几台设备？预算多少？</strong>\n          答案落定，再匹配线路、节点和带宽，避免为用不到的能力买单。\n        </p>\n        <div class=\"qline\">\n          <a href=\"#plans\" class=\"solid\">查看三档套餐</a>\n          <a href=\"#usage\">三步开始使用</a>\n          <a href=\"#faq\">常见问题</a>\n        </div>\n      </div>\n\n      <aside class=\"info-panel\">\n        <h2>先回答你关心的几件事</h2>\n        <dl>\n          <dt>适合谁</dt>\n          <dd>追剧用户、远程办公者、小团队、游戏玩家</dd>\n          <dt>线路构成</dt>\n          <dd>普通线路池与 IPLC 专线混合，按套餐开放</dd>\n          <dt>设备上限</dt>\n          <dd>3 台 / 5 台 / 20 台，依套餐而定</dd>\n          <dt>支付方式</dt>\n          <dd>月付与年付，年付折算更优惠</dd>\n        </dl>\n        <div class=\"qa\">\n          <p><b>问：芒果云会承诺“不限速”吗？</b></p>\n          <p>不会。我们更愿意说清楚每档套餐的流量额度与节点类型，让你自己判断是否够用。</p>\n          <p><b>问：没有客户端下载链接怎么办？</b></p>\n          <p>本页客户端区块给出平台说明，具体下载地址以购买后站内指引为准，不在此页伪造链接。</p>\n        </div>\n      </aside>\n    </div>\n  </div>\n</header>\n\n<main>\n\n<section id=\"why\">\n  <div class=\"wrap\">\n    <h2>为什么是问答引导式？</h2>\n    <p class=\"section-intro\">\n      多数加速服务把“套餐表”丢给你就结束。芒果云反过来：先问，再选。\n      下面三个问题决定了你应该看哪一档，也决定了我们如何分配节点与带宽。\n    </p>\n\n    <article class=\"numbered\">\n      <span class=\"big-num\">01</span>\n      <span class=\"tag\">第一问</span>\n      <h3>你主要在看什么内容？</h3>\n      <p>\n        如果只是偶尔刷新闻、看短视频，普通线路池足够；\n        若要解锁原生流媒体、看高码率剧集，则需要旗舰版以上的全节点解锁能力；\n        若是企业远程办公、大文件同步，团队版的高带宽节点更稳。\n      </p>\n      <p>答案直接指向节点类型，而不是先看价格。</p>\n    </article>\n\n    <article class=\"numbered\">\n      <span class=\"big-num\">02</span>\n      <span class=\"tag\">第二问</span>\n      <h3>同时有几台设备要连？</h3>\n      <p>\n        一个人手机加笔记本，3 台上线基本够用；\n        家庭共享或小工作室，5 台更从容；\n        超过 10 台设备同时在线的团队，建议直接选团队版，避免频繁踢线。\n      </p>\n      <p>设备数不是“越多越好”，而是“够用就好”。</p>\n    </article>\n\n    <article class=\"numbered\">\n      <span class=\"big-num\">03</span>\n      <span class=\"tag\">第三问</span>\n      <h3>你愿意为哪一项能力付费？</h3>\n      <p>\n        有人愿意为 IPLC 专线付更多，有人更在意月费总额。\n        芒果云把三项套餐拆成单列大卡，逐张展开，让你看清每一档多付的钱买了什么、没买什么。\n      </p>\n      <p>不打包、不捆绑、不制造“限时焦虑”。</p>\n    </article>\n  </div>\n</section>\n\n<section id=\"plans\">\n  <div class=\"wrap\">\n    <h2>三档套餐，按问题答案对号入座</h2>\n    <p class=\"section-intro\">\n      以下套餐价格与权益均为芒果云当前在售方案。年付价格折算后低于月付累计，\n      但我们不把它写成“立省几百”的促销话术，只写实际数字。\n    </p>\n\n    <article class=\"plan-card\">\n      <div class=\"plan-head\">\n        <div>\n          <h3>基础版</h3>\n          <p>适合：轻度追剧、单人使用、预算敏感</p>\n        </div>\n        <div>\n          <div class=\"price\">¥15<span>/月</span></div>\n          <span class=\"annual\">按年付仅需 ¥150/年</span>\n        </div>\n      </div>\n      <ul>\n        <li>每月 100GB 极速流量</li>\n        <li>支持 3 台设备同时在线</li>\n        <li>解锁基础流媒体</li>\n        <li>普通线路节点池</li>\n      </ul>\n      <a href=\"#\" class=\"cta\">选择基础版</a>\n    </article>\n\n    <article class=\"plan-card featured\">\n      <div class=\"plan-head\">\n        <div>\n          <h3>旗舰版 <span class=\"featured-flag\">推荐</span></h3>\n          <p>适合：重度流媒体、游戏加速、家庭共享</p>\n        </div>\n        <div>\n          <div class=\"price\">¥35<span>/月</span></div>\n          <span class=\"annual\">按年付仅需 ¥350/年</span>\n        </div>\n      </div>\n      <ul>\n        <li>每月 300GB 极速流量</li>\n        <li>支持 5 台设备同时在线</li>\n        <li>全节点原生流媒体解锁</li>\n        <li>IPLC 专线游戏加速优化</li>\n        <li>7x24 优先工单支持</li>\n      </ul>\n      <a href=\"#\" class=\"cta\">选择旗舰版</a>\n    </article>\n\n    <article class=\"plan-card\">\n      <div class=\"plan-head\">\n        <div>\n          <h3>团队版</h3>\n          <p>适合：小团队、远程办公、企业定制路由</p>\n        </div>\n        <div>\n          <div class=\"price\">¥85<span>/月</span></div>\n          <span class=\"annual\">按年付仅需 ¥850/年</span>\n        </div>\n      </div>\n      <ul>\n        <li>每月 1000GB 极速流量</li>\n        <li>支持 20 台设备同时在线</li>\n        <li>VIP 专属高带宽节点</li>\n        <li>支持企业定制路由</li>\n        <li>专属客户经理服务</li>\n      </ul>\n      <a href=\"#\" class=\"cta\">选择团队版</a>\n    </article>\n  </div>\n</section>\n\n<section id=\"usage\">\n  <div class=\"wrap\">\n    <h2>怎么开始用？三步而已</h2>\n    <p class=\"section-intro\">\n      芒果云不要求你先读懂协议名词。按下面三步走，从下单到连上节点，通常在十几分钟内完成。\n    </p>\n\n    <div class=\"usage-grid\">\n      <article class=\"usage-step\">\n        <div class=\"step-no\">STEP 01</div>\n        <h3>回答三个问题，选定套餐</h3>\n        <p>根据上面的“看什么、几台设备、愿意付什么”三问，在基础版、旗舰版、团队版中选一档。不确定时先选月付试水。</p>\n      </article>\n\n      <article class=\"usage-step\">\n        <div class=\"step-no\">STEP 02</div>\n        <h3>登录站点，查看节点与订阅</h3>\n        <p>购买后进入芒果云用户中心，查看你的流量额度、设备上限、节点列表与订阅地址。旗舰版以上会看到 IPLC 专线节点分组。</p>\n      </article>\n\n      <article class=\"usage-step\">\n        <div class=\"step-no\">STEP 03</div>\n        <h3>在客户端导入并连接</h3>\n        <p>把订阅地址导入对应平台客户端，选择节点，连接。若遇到解锁失败或速度异常，可在工单中说明你的套餐与目标站点。</p>\n      </article>\n    </div>\n  </div>\n</section>\n\n<section id=\"client\">\n  <div class=\"wrap\">\n    <h2>客户端：用你顺手的工具</h2>\n    <p class=\"section-intro\">\n      芒果云提供订阅地址，不强制安装某一款“专属客户端”。\n      你可以使用各平台上成熟的通用客户端导入订阅，下面分两类说明。\n    </p>\n\n    <div class=\"client-grid\">\n      <article class=\"client-block\">\n        <h3>桌面端</h3>\n        <p>\n          Windows 与 macOS 用户可使用支持芒果云订阅格式的通用客户端。\n          导入订阅地址后，在节点列表中选择对应区域，建议优先选择与目标流媒体同区域的节点。\n        </p>\n        <p>\n          旗舰版及以上用户若使用 IPLC 专线节点，请在客户端中确认路由规则没有把专线域名分流到普通线路。\n        </p>\n        <div class=\"platforms\">\n          <span>Windows 10/11</span>\n          <span>macOS 12+</span>\n          <span>Linux（通用客户端）</span>\n        </div>\n        <p class=\"note\">\n          本页不提供具体下载链接。购买后请在芒果云用户中心查看推荐的客户端与导入指引，避免从第三方来源下载被篡改的安装包。\n        </p>\n      </article>\n\n      <article class=\"client-block\">\n        <h3>移动端</h3>\n        <p>\n          iOS 与 Android 用户可使用各自平台上的通用客户端导入芒果云订阅。\n          基础版最多 3 台设备同时在线，手机与平板各算一台，请注意设备上限。\n        </p>\n        <p>\n          团队版用户若需为团队成员分发订阅，建议联系专属客户经理协助配置，避免直接外泄主订阅地址。\n        </p>\n        <div class=\"platforms\">\n          <span>iOS 15+</span>\n          <span>Android 10+</span>\n          <span>iPadOS</span>\n        </div>\n        <p class=\"note\">\n          若平台商店在你所在区域不可用，请通过芒果云工单获取替代获取方式，不要轻信非官方渠道的“芒果云破解版”。\n        </p>\n      </article>\n    </div>\n  </div>\n</section>\n\n<section id=\"faq\">\n  <div class=\"wrap\">\n    <h2>常见问题</h2>\n    <p class=\"section-intro\">\n      以下问题来自用户选购前最常提出的疑问。点击展开查看回答；若你的问题不在其中，可在工单中提交。\n    </p>\n\n    <div class=\"faq-list\">\n      <details class=\"qa\">\n        <summary>基础版能不能升级到旗舰版？</summary>\n        <div class=\"answer\">\n          <p>可以。你可以在芒果云用户中心对当前订阅进行升级，系统会按剩余时长折算差价，不需要重新购买全年套餐。</p>\n          <p>升级后，流量额度、设备上限和节点类型会立即切换到旗舰版的权益；当月已用流量不会重置，请在升级前留意剩余额度。</p>\n        </div>\n      </details>\n\n      <details class=\"qa\">\n        <summary>旗舰版的 IPLC 专线和普通线路有什么区别？</summary>\n        <div class=\"answer\">\n          <p>IPLC 专线节点通常用于对延迟和稳定性更敏感的场景，例如游戏加速、实时会议、大文件同步。普通线路池则覆盖日常浏览与流媒体观看。</p>\n          <p>两者并非“好坏”之分，而是定位不同。基础版只提供普通线路池；旗舰版及以上才会开放 IPLC 专线分组。</p>\n        </div>\n      </details>\n\n      <details class=\"qa\">\n        <summary>“解锁流媒体”具体指什么？</summary>\n        <div class=\"answer\">\n          <p>基础版标注“解锁基础流媒体”，旗舰版标注“全节点原生流媒体解锁”。这意味着不同套餐在节点类型和区域覆盖上存在差异，部分内容可能需要特定区域节点才能正常播放。</p>\n          <p>芒果云不承诺“解锁全部内容一切可用”，因为内容方的区域策略会随时调整。遇到无法播放的情况，请在工单中说明套餐、节点区域和目标站点，便于排查。</p>\n        </div>\n      </details>\n\n      <details class=\"qa\">\n        <summary>团队版的 20 台设备可以给不同人用吗？</summary>\n        <div class=\"answer\">\n          <p>可以。团队版面向小团队和企业场景，支持最多 20 台设备同时在线，设备可以属于不同成员。</p>\n          <p>但芒果云不建议把主订阅地址直接分发给所有人。更稳妥的做法是通过专属客户经理为不同成员配置独立接入方式，便于管理和回收。</p>\n        </div>\n      </details>\n\n      <details class=\"qa\">\n        <summary>年付和月付的权益一样吗？</summary>\n        <div class=\"answer\">\n          <p>权益完全一致。年付只是把十二个月的钱一次性付清，折算后比按月累计更低：基础版 ¥150/年、旗舰版 ¥350/年、团队版 ¥850/年。</p>\n          <p>年付不会额外赠送“隐藏节点”或“神秘权益”，我们不想用这种话术促使你多付钱。如果你更倾向灵活，月付完全没问题。</p>\n        </div>\n      </details>\n\n      <details class=\"qa\">\n        <summary>流量用完了怎么办？</summary>\n        <div class=\"answer\">\n          <p>套餐流量用完后，当月将无法继续连接节点，需等待次月额度重置，或购买额外流量包（以站内当时提供的选项为准）。</p>\n          <p>如果你发现每月都提前用完，多半是选错了套餐。可在用户中心查看用量趋势，再决定是否升级到更高档位。</p>\n        </div>\n      </details>\n\n      <details class=\"qa\">\n        <summary>如果用不合适，可以退款吗？</summary>\n        <div class=\"answer\">\n          <p>芒果云的退款政策以购买时站内说明为准。本页不代为承诺具体退款条件，以免与实际规则不一致。</p>\n          <p>建议在购买前先选月付试用，确认节点和解锁效果符合预期后再决定是否转为年付，降低决策成本。</p>\n        </div>\n      </details>\n    </div>\n  </div>\n</section>\n\n</main>\n\n<footer>\n  <div class=\"wrap\">\n    <div>\n      <div class=\"brand\">芒果云</div>\n      <div>问答引导式网络加速服务</div>\n    </div>\n    <div>\n      <div><a href=\"#plans\">套餐</a> · <a href=\"#usage\">使用</a> · <a href=\"#client\">客户端</a> · <a href=\"#faq\">FAQ</a></div>\n      <div>本页内容以芒果云在售方案为准，未经核实的信息不在此编造。</div>\n    </div>\n  </div>\n</footer>",
